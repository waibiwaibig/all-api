{
  "name": "@waibiwaibig/all-api",
  "version": "0.6.0",
  "description": "Local bridge exposing coding agents through OpenAI, Anthropic, and native protocols.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waibiwaibig/all-api.git"
  },
  "bugs": {
    "url": "https://github.com/waibiwaibig/all-api/issues"
  },
  "homepage": "https://github.com/waibiwaibig/all-api#readme",
  "bin": {
    "all-api": "src/cli.mjs"
  },
  "files": [
    "src",
    "DECISION_MAP.md",
    "docs"
  ],
  "scripts": {
    "start": "node ./src/cli.mjs up",
    "detect": "node ./src/cli.mjs detect",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:real-agents": "ALL_API_REAL_AGENTS=1 node --test test/real-agents.test.mjs",
    "check": "node --check src/cli.mjs && node --check src/server.mjs && node --check src/agents.mjs && node --check src/admin.mjs && node --check src/platform.mjs && node --check src/agent-service.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "ajv": "^8.20.0",
    "ws": "^8.21.1"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "openai": "^6.49.0"
  }
}
